# Credentials — never commit
.env
*.token.json
oauth2.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Draft assistant runtime state — the pick log/exports are draft-day
# artifacts, not source; the board CSVs you download are also yours to keep
# out of version control. draft_log.*.jsonl also covers draft_store.py's
# dated archive copies (e.g. draft_log.20260809-194842.jsonl), not just the
# live file.
draft_log.jsonl
draft_log.*.jsonl
draft/

# Intel refresh snapshots — dated working artifacts, not source
draft/intel_history/

# In-season weekly reports — one dated snapshot per week, regenerated by
# /gameday, plus the remembered lineup state. Specific patterns rather than
# a blanket `weekly/` so weekly/week-NN.example.yml (the committed template)
# stays tracked — a directory-level exclude can't be re-included afterward.
# Your actual roster stays out of version control too (it's your team, not
# the tool's). league.yml is the same idea one level up — it's your league's
# real scoring rules, not a fact about the tool; league.example.yml is the
# committed template.
weekly/week-[0-9][0-9].yml
weekly/lineup_state.yml

# ffbot/week_log.py's per-run recommendation records -- one JSON per (week,
# decision moment) holding exactly what the Recommendations panel showed and
# every metric behind each row, so a call can be reviewed after the fact. A
# whole directory rather than a pattern, unlike the week-NN.yml rule just
# above: nothing under weekly/reports/ is ever hand-written or committed, so
# there is no example file to re-include. Personal and accumulating;
# regenerable only in the sense that it starts empty -- a week's pre-kickoff
# snapshot can never be rebuilt once the live projections and the wire have
# moved on, the same caution as data/kalshi_log/ below.
weekly/reports/
roster.yml
league.yml

# Internal working notes (backtest tuning log, roadmap, migration history) —
# useful to the maintainer, not needed by anyone who clones this as a
# template. See private/*.md's own headers for what moved here and why.
private/

# Imported rival rosters (scripts/import_league_rosters.py) -- generated,
# league-specific, and made from names your league mates chose, not source.
league_rosters.yml

# GUI settings overlay (see Config.load) -- config.yml is hand-narrated with
# comments a YAML round-trip would destroy, so the GUI writes here instead.
config.local.yml

# Backtest historical-data cache (ffbot/history/fetch.py) -- multi-decade
# nflverse/DynastyProcess CSV downloads, regenerable at any time via
# scripts/history_fetch.py, not source. A specific pattern rather than a
# blanket `data/` so a future committed reference file under data/ (like
# data/stadiums.yml today) stays tracked.
data/history/

# scripts/backtest_tune.py --out / scripts/backtest_draft.py --out JSON dumps
# -- reproducible sweep results, not source. See docs/dev/BACKTEST.md's B5
# section for the numbers that matter; these are the raw backing data.
data/backtest/

# scripts/demo_season.py's generated demo environment(s) -- throwaway,
# rebuildable at any time via `build`, not source.
demo/

# ffbot/projections/cache.py's live weekly-projection cache -- unlike
# data/history/, these fetches are TTL'd and expected to go stale by
# design, not a stable archive worth ever re-adding to source.
data/projections/

# ffbot/sleeper/cache.py's TTL'd league/roster/draft cache -- same reasoning
# as data/projections/ above.
data/sleeper/

# ffbot/live/cache.py's TTL'd weather/market cache -- same reasoning as
# data/projections/ above.
data/live/

# ffbot/markets/kalshi_log.py's forward-logged Kalshi player-prop snapshots
# (B7) -- accumulating, personal, in-progress evidence toward a future
# season's grading pass, not source. Regenerable in the sense that it
# starts empty; NOT regenerable in the sense that a lost week's snapshot
# can never be recovered after the fact -- back this up separately if you
# actually run spice_level 4 during a season, same caution as any other
# personal weekly-report artifact under reports/.
data/kalshi_log/

# scripts/autorun.py's generated artifacts -- personal weekly reports and
# idempotency state, not source.
reports/
data/autorun_state.json

# Untracked scratch from tuning sessions — see experiments/README.md
experiments/
